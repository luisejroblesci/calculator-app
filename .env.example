# Copy to .env.local for local runs against a docker-compose Postgres
# (chunk sidecar ssh / chunk validate --remote load .env.local automatically
# and forward it to the sidecar too — the sidecar's own postgres uses these
# same values, provisioned by the "postgres" step in .chunk/config.json).
PGHOST=localhost
PGPORT=5432
PGUSER=calc
PGPASSWORD=calc
PGDATABASE=calculator
